# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: (Optional) DeepSeek API Key for alternative AI backend
DEEPSEEK_API_KEY=

# GROQ_API_KEY: (Optional) Groq API Key for Tier 3 emergency AI fallback (e.g. gsk_...)
GROQ_API_KEY=
# GROQ_MODEL: (Optional) Groq model name (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# KAVENEGAR_API_KEY: (Optional) Kavenegar API key for Iranian mobile OTP SMS verification
KAVENEGAR_API_KEY=
# KAVENEGAR_OTP_TEMPLATE: (Optional) Kavenegar lookup template name (default: math-tutor-otp)
KAVENEGAR_OTP_TEMPLATE=math-tutor-otp
# KAVENEGAR_SENDER: (Optional) Dedicated sender line number for fallback SMS (e.g. 1000..., 2000...)
KAVENEGAR_SENDER=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_SECRET: Secret key for protected admin routes (/api/admin/reports, /api/admin/token-stats)
ADMIN_SECRET=

# Server Token Manager (Optional daily limits for Gemini/Groq cost control)
DAILY_FREE_AI_LIMIT=7
DAILY_VIP_AI_LIMIT=100
DAILY_FREE_AI_TOKEN_LIMIT=35000
DAILY_VIP_AI_TOKEN_LIMIT=300000
DAILY_GLOBAL_AI_REQUEST_LIMIT=1500
DAILY_GLOBAL_AI_TOKEN_LIMIT=2000000
