{
	"appId": "ir.ostaddana.math3",
	"appName": "استاد دانا",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 900,
			"launchAutoHide": true,
			"backgroundColor": "#FBF6EC",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#FFFDF8",
			"overlaysWebView": false
		}
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	}
}
